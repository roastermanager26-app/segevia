# ==============================================================================
# VARIABLES DE ENTORNO — PLATAFORMA DE AGENTES DE VENTAS CON IA
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a `.env.local` para desarrollo local: `cp .env.example .env.local`
# 2. Llena los valores reales en `.env.local` o en el panel de Vercel (Project Settings -> Environment Variables).
# 3. NUNCA subas archivos `.env` o `.env.local` a GitHub. Están ignorados en .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Base de datos, Auth, Storage, Vector)
# ------------------------------------------------------------------------------
# Obtenidos en: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Clave de Servicio (SOLO para backend / worker / scripts administrativos — NUNCA exponer en frontend)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# Cadena de conexión directa de PostgreSQL (para migraciones CLI)
# Obtenida en: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.[TU-PROYECTO].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. MODELOS DE INTELIGENCIA ARTIFICIAL (LLMs)
# ------------------------------------------------------------------------------
# Gateway multimodelo principal (OpenRouter da acceso a OpenAI, Claude, Gemini, etc.)
# Obtenido en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-tu-clave-openrouter

# Clave directa de Google AI (Gemini 2.5 Flash para RAG rápido y embeddings)
# Obtenido en: https://aistudio.google.com/
GEMINI_API_KEY=tu-clave-gemini-aistudio

# Clave directa de OpenAI (opcional / fallback)
# Obtenido en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-tu-clave-openai

# ------------------------------------------------------------------------------
# 3. BÚSQUEDA WEB Y TENDENCIAS (Content Studio)
# ------------------------------------------------------------------------------
# Motor de búsqueda web optimizado para LLMs
# Obtenido en: https://tavily.com
TAVILY_API_KEY=tvly-tu-clave-tavily

# ------------------------------------------------------------------------------
# 4. GENERACIÓN DE IMÁGENES (Content Studio)
# ------------------------------------------------------------------------------
# Proveedor para generación de imágenes (Flux / SDXL)
# Obtenido en: https://fal.ai o https://replicate.com
FAL_KEY=tu-clave-fal-ai
REPLICATE_API_TOKEN=tu-clave-replicate

# ------------------------------------------------------------------------------
# 5. CANALES: META (WhatsApp Cloud API & Instagram)
# ------------------------------------------------------------------------------
# Obtenidos en: Meta for Developers (https://developers.facebook.com)
META_APP_ID=tu-meta-app-id
META_APP_SECRET=tu-meta-app-secret
WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id
WHATSAPP_ACCESS_TOKEN=tu-meta-system-user-access-token
WHATSAPP_VERIFY_TOKEN=un_token_secreto_elegido_por_ti_para_el_webhook
INSTAGRAM_ACCOUNT_ID=tu-instagram-business-account-id

# ------------------------------------------------------------------------------
# 6. CANALES: LINKEDIN API (Publicaciones)
# ------------------------------------------------------------------------------
# Obtenidos en: LinkedIn Developer Portal (https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=tu-linkedin-client-id
LINKEDIN_CLIENT_SECRET=tu-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://tu-dominio-o-localhost/api/auth/linkedin/callback

# ------------------------------------------------------------------------------
# 7. CANALES: X (TWITTER) API v2
# ------------------------------------------------------------------------------
# Obtenidos en: X Developer Portal (https://developer.x.com)
X_API_KEY=tu-x-api-key
X_API_SECRET=tu-x-api-secret
X_ACCESS_TOKEN=tu-x-access-token
X_ACCESS_SECRET=tu-x-access-secret

# ------------------------------------------------------------------------------
# 8. TELEFONÍA Y AGENTES DE VOZ (Cold Calls & Inbound)
# ------------------------------------------------------------------------------
# Proveedor gestionado de llamadas (Vapi o Retell AI)
VAPI_API_KEY=tu-vapi-api-key
# o RETELL_API_KEY=tu-retell-api-key

# Proveedor SIP / Telefonía directa (opcional si usas Twilio)
TWILIO_ACCOUNT_SID=tu-twilio-account-sid
TWILIO_AUTH_TOKEN=tu-twilio-auth-token

# ------------------------------------------------------------------------------
# 9. CRM PROPIETARIO
# ------------------------------------------------------------------------------
# Endpoint y credenciales para sincronizar leads y actividades
CRM_API_BASE_URL=https://api.tu-crm.com/v1
CRM_API_KEY=tu-clave-de-acceso-al-crm

# ------------------------------------------------------------------------------
# 10. ENTORNO GENERAL
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:5173
